[Unit]
Description=xueify notification daemon
Documentation=man:xueify(1) https://github.com/ouxan/xueify
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=org.freedesktop.Notifications
ExecStart=@BINDIR@/xueify
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
